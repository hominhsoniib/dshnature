# ===== Database (Neon PostgreSQL) — dùng chung cho Payload CMS và Prisma =====
DATABASE_URL="postgresql://user:password@ep-xxxxx.neon.tech/dsh_nature?sslmode=require"

# ===== Payload CMS =====
# Chuỗi bí mật ký JWT cho phiên đăng nhập /admin — tạo ngẫu nhiên, đủ dài (vd: openssl rand -base64 32)
PAYLOAD_SECRET=

# ===== Cloudflare R2 (media storage — qua @payloadcms/storage-s3) =====
R2_BUCKET=dsh-nature-media
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME: cùng bucket với R2_BUCKET ở trên, nhưng là biến RIÊNG mà
# src/lib/r2-client.ts (upload thủ công, phục vụ mục đích khác — không phải
# Payload Media) tự đọc. Cần set cả 2 biến (cùng giá trị bucket) — thiếu 1
# trong 2 sẽ gây lỗi ở đúng tính năng tương ứng.
R2_BUCKET_NAME=dsh-nature-media
# R2_PUBLIC_URL: domain public của bucket (bật Public Access trên Cloudflare
# R2 dashboard — dùng r2.dev subdomain hoặc custom domain riêng). Dùng để
# build URL ảnh Media trỏ thẳng ra R2 (generateFileURL, payload.config.ts)
# thay vì proxy qua Payload. Để trống nếu chưa bật Public Access — Payload
# tự fallback về proxy nội bộ, không crash.
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"

# ===== NextAuth (auth khách hàng — tách biệt hoàn toàn với Payload admin auth) =====
NEXTAUTH_URL="http://localhost:3000"
# Tạo ngẫu nhiên, đủ dài (vd: openssl rand -base64 32)
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Email (Resend) =====
RESEND_API_KEY=
# Địa chỉ gửi đi — phải là domain đã verify trên Resend. Để trống sẽ dùng
# sandbox sender "onboarding@resend.dev" (chỉ gửi được tới email chủ tài khoản Resend).
RESEND_FROM_EMAIL="DSH Nature <no-reply@dshnature.vn>"
# Email nội bộ nhận thông báo mỗi khi có form liên hệ/đại lý/tư vấn/đơn hàng mới.
ADMIN_NOTIFICATION_EMAIL=dshnature@gmail.com

# ===== Thanh toán — cấu hình đầy đủ khi vào PHASE 3 (Cart/Checkout) =====
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
